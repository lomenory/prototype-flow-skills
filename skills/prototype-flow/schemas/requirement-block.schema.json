{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-flow.local/schemas/requirement-block.schema.json",
  "title": "PRD 需求块元数据",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "demoCoverage": {
      "type": "object",
      "required": ["schemaVersion", "items"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"const": 1},
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "screenId", "stateId"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
              "title": {"type": "string", "minLength": 1},
              "screenId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
              "stateId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
              "fixtureId": {"type": "string"}
            }
          }
        }
      },
      "description": "明确此需求预期的 Demo 页面状态；不根据已存在 binding 推导分母。ID 和页面状态目标必须唯一。"
    },
    "priority": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
      },
      "uniqueItems": true
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true,
  "description": "仅描述 pf:req 注释中的 JSON。块内必须有 Markdown 标题；ID 改名和移动时保持稳定。"
}
