{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Flow conversation snapshot v1",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "observedAt", "project", "versionId", "historical", "scope", "basis", "data", "freshness", "actions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "snapshotId": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "format": "date-time"},
    "project": {"type": "object", "required": ["id", "name", "rootHint", "storedRevision"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "rootHint": {"type": "string"}, "storedRevision": {"type": "integer"}}},
    "versionId": {"type": "string"},
    "historical": {"type": "boolean"},
    "scope": {"type": "object", "required": ["view"], "properties": {"view": {"enum": ["overview", "module", "requirement", "tasks", "task", "history", "compare", "result"]}}},
    "basis": {"type": "object"}, "data": {"type": "object"}, "freshness": {"type": "object"},
    "page": {"type": ["object", "null"]},
    "actions": {"type": "array", "items": {"type": "object", "required": ["intent", "enabled"], "properties": {"intent": {"enum": ["inspect", "change", "read-latest", "open-demo", "open-workbench", "compare", "continue-run", "export-module"]}, "enabled": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}}}
  }
}
