{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-flow.local/schemas/project.schema.json",
  "title": "Prototype Flow 项目清单",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "libraryRoot",
    "mode",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "libraryRoot": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "local",
        "feishu"
      ]
    },
    "maintainerPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "documentId",
          "documentPath",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "title": {
            "type": "string"
          },
          "documentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "documentPath": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
