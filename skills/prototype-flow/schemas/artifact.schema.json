{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-flow.local/schemas/artifact.schema.json",
  "title": "Demo 产物注册输入与运行时字段",
  "type": "object",
  "required": [
    "id",
    "path",
    "entryHtml",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "title": {
      "type": "string",
      "description": "业务产物名称；需求变更涉及名称时通过 demo-edit --title 声明，成功 demo-save 自动应用。旧冻结产物及旧修订保留原名，不从需求文本自动推断。"
    },
    "path": {
      "type": "string",
      "pattern": "^demos/"
    },
    "entryHtml": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "frameworkId": {
      "type": "string",
      "description": "运行时从任务固定输入取得，不能指定不同版本"
    },
    "frameworkPath": {
      "const": "_framework",
      "readOnly": true
    },
    "baseArtifactId": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "description": "继承业务页面的完整 Demo ID"
    },
    "sourceDemoPath": {
      "type": "string",
      "readOnly": true,
      "description": "首次接入尚未登记的 Demo 时，记录其项目内原始目录"
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 0
    },
    "requirementHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 1
    },
    "documentHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "current"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "frameworkReview": {
          "type": "object",
          "required": [
            "summary",
            "source"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "实际验证报告或截图的项目相对路径，文件必须位于本 Demo 目录内并随工作稿修订或冻结产物保存"
            },
            "mode": {
              "enum": [
                "observed",
                "inherited"
              ],
              "description": "省略时沿用 observed；inherited 需相同框架及已验证固定基线。"
            },
            "fromArtifactId": {
              "type": "string"
            },
            "inheritedFrameworkId": {
              "type": "string",
              "description": "继承时由运行时固定。"
            }
          },
          "description": "框架任务的 verified/current 产物必须提供实际复用检查记录；由运行时结合 runId 检查"
        }
      }
    },
    "fileHashes": {
      "type": "object",
      "description": "有 resourceManifest 时恰好覆盖 runtimeFiles 与 archiveFiles；无清单的旧产物沿用全目录哈希。",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "resourceManifest": {
      "$ref": "#/$defs/resourceManifest"
    },
    "createdAt": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "readOnly": true,
      "description": "working-draft 表示可经专用命令推进修订的工作稿，frozen 表示冻结版；历史不可变产物可没有此字段。不能用 artifact 注册覆盖工作稿。"
    },
    "draftRevision": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true,
      "description": "工作稿的已保存修订。保存与恢复均产生新修订。"
    },
    "activeRunId": {
      "type": ["string", "null"],
      "readOnly": true,
      "description": "当前占用工作稿的编辑任务；同一工作稿不并行编辑。"
    },
    "editStatus": {
      "enum": ["editing", "ready", "needs-review"],
      "readOnly": true
    },
    "draftSourceArtifactId": {
      "type": ["string", "null"],
      "readOnly": true,
      "description": "首次建立工作稿的来源产物，原冻结目录保持不变。"
    },
    "lastFrozenArtifactId": {
      "type": ["string", "null"],
      "readOnly": true
    },
    "lastFrozenRevision": {
      "type": ["integer", "null"],
      "minimum": 0,
      "readOnly": true
    },
    "restoredFromRevision": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true,
      "description": "本次恢复所依据的旧工作稿修订；draftRevision 仍递增。"
    },
    "frozenFrom": {
      "type": "object",
      "required": ["artifactId", "revision"],
      "properties": {
        "artifactId": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false,
      "readOnly": true,
      "description": "冻结完整产物所对应的工作稿及已保存修订，不表示用户确认或发布。"
    },
    "frozenRelations": {
      "type": "object",
      "properties": {
        "bindings": {"type": "array", "items": {"type": "object"}},
        "flows": {"type": "array", "items": {"type": "object"}}
      },
      "readOnly": true,
      "description": "该冻结产物对应的页面证据与流程副本；不会重新加入当前 relations.json。按产物定向校验时读取。"
    },
    "change": {
      "type": "object",
      "required": [
        "tier",
        "summary"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "affectedBindingIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "required": [
        "runId"
      ]
    },
    {
      "required": [
        "inputRevision",
        "requirementHashes"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "current"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "resourcePaths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "description": "相对本 Demo 根目录的路径；运行时拒绝绝对路径、越界路径及分类冲突。"
    },
    "resourceDeclaration": {
      "type": "object",
      "properties": {
        "schemaVersion": {"const": 1},
        "entryPoints": {"$ref": "#/$defs/resourcePaths"},
        "runtimeFiles": {"$ref": "#/$defs/resourcePaths"},
        "archiveFiles": {"$ref": "#/$defs/resourcePaths"},
        "excludedFiles": {"$ref": "#/$defs/resourcePaths"},
        "runtimeDirectories": {"$ref": "#/$defs/resourcePaths"},
        "archiveDirectories": {"$ref": "#/$defs/resourcePaths"},
        "excludedDirectories": {"$ref": "#/$defs/resourcePaths"},
        "complete": {"type": "boolean", "description": "true 表示声明已覆盖全部动态运行资源，且 runtimeFiles/runtimeDirectories 须展开至少一个文件；不能仅凭静态扫描或一次访问填写。"}
      },
      "additionalProperties": false
    },
    "resourceManifest": {
      "type": "object",
      "required": ["schemaVersion"],
      "description": "资源策略 v1。输入可声明文件或目录；保存后 entryPoints/runtimeFiles/archiveFiles/excludedFiles 为精确路径，unresolved 保存未解决分类或依赖。临时文件不进入新正式修订，但不删除工作文件。缺少本字段表示旧格式。",
      "properties": {
        "schemaVersion": {"const": 1},
        "entryPoints": {"$ref": "#/$defs/resourcePaths"},
        "runtimeFiles": {"$ref": "#/$defs/resourcePaths"},
        "archiveFiles": {"$ref": "#/$defs/resourcePaths"},
        "excludedFiles": {"$ref": "#/$defs/resourcePaths"},
        "runtimeDirectories": {"$ref": "#/$defs/resourcePaths"},
        "archiveDirectories": {"$ref": "#/$defs/resourcePaths"},
        "excludedDirectories": {"$ref": "#/$defs/resourcePaths"},
        "complete": {"type": "boolean"},
        "excludedReasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "readOnly": true, "description": "持久清单中按路径保存排除原因，键与 excludedFiles 一致；兼容省略该字段的早期清单，不作为声明输入。"},
        "unresolved": {"type": "array", "items": {"type": "string"}, "readOnly": true},
        "declaration": {"$ref": "#/$defs/resourceDeclaration", "description": "保存输入声明，供后续修订重新展开动态资源目录；导出使用已保存的精确清单。"}
      },
      "additionalProperties": false
    }
  }
}
