{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-flow.local/schemas/artifact.schema.json",
  "title": "完整 Demo 产物注册输入",
  "type": "object",
  "required": [
    "id",
    "path",
    "entryHtml",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "title": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "pattern": "^demos/"
    },
    "entryHtml": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "frameworkId": {
      "type": "string",
      "description": "运行时从任务固定输入取得，不能指定不同版本"
    },
    "frameworkPath": {
      "const": "_framework",
      "readOnly": true
    },
    "baseArtifactId": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "description": "继承业务页面的完整 Demo ID"
    },
    "sourceDemoPath": {
      "type": "string",
      "readOnly": true,
      "description": "首次接入尚未登记的 Demo 时，记录其项目内原始目录"
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 0
    },
    "requirementHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 1
    },
    "documentHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "current"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "frameworkReview": {
          "type": "object",
          "required": [
            "summary",
            "source"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "实际验证报告或截图的项目相对路径，文件必须位于本 Demo 目录内并随产物冻结"
            },
            "mode": {
              "enum": [
                "observed",
                "inherited"
              ],
              "description": "省略时沿用 observed；inherited 需相同框架及已验证固定基线。"
            },
            "fromArtifactId": {
              "type": "string"
            },
            "inheritedFrameworkId": {
              "type": "string",
              "description": "继承时由运行时固定。"
            }
          },
          "description": "框架任务的 verified/current 产物必须提供实际复用检查记录；由运行时结合 runId 检查"
        }
      }
    },
    "fileHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "createdAt": {
      "type": "string"
    },
    "change": {
      "type": "object",
      "required": [
        "tier",
        "summary"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "affectedBindingIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "required": [
        "runId"
      ]
    },
    {
      "required": [
        "inputRevision",
        "requirementHashes"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "current"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
