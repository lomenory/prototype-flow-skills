{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-flow.local/schemas/relations.schema.json",
  "title": "需求、用户流程和页面截图关联",
  "type": "object",
  "required": [
    "schemaVersion",
    "flows",
    "bindings",
    "supersessions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirementIds",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "title": {
            "type": "string"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "previousRequirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "bindingId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                },
                "requirementId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                },
                "artifactId": {
                  "type": "string"
                },
                "screenId": {
                  "type": "string"
                },
                "stateId": {
                  "type": "string"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "bindingId"
                  ]
                },
                {
                  "required": [
                    "requirementId"
                  ]
                },
                {
                  "required": [
                    "artifactId",
                    "screenId",
                    "stateId"
                  ]
                }
              ],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirementIds",
          "artifactId",
          "screenId",
          "stateId",
          "route",
          "fixtureId",
          "screenshot",
          "verified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "previousRequirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "artifactId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "screenId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "stateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "fixtureId": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object"
          },
          "verificationHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$",
            "description": "运行时固定的截图、产物、需求、入口及状态指纹；旧数据缺失时待复核"
          },
          "verificationStatus": {
            "type": "string",
            "description": "verified、inherited，或 missing-fingerprint、fingerprint-changed、dependency-changed；保留旧状态兼容"
          },
          "reverify": {
            "type": "boolean",
            "description": "本次确已重新验证时使用；运行时消费后不保存"
          },
          "contractRefs": {
            "type": "object"
          },
          "status": {
            "type": "string"
          },
          "verificationScope": {
            "type": "object",
            "required": [
              "files",
              "complete"
            ],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "complete": {
                "const": true
              }
            },
            "additionalProperties": false,
            "description": "实际验证时确认完整的页面依赖，路径相对 Demo；运行时补充入口、共享代码与框架。未知动态依赖不能跨产物继承。"
          },
          "inheritVerificationFrom": {
            "type": "string",
            "description": "请求继承现有已验证 binding ID 的证据；可与本 binding ID 相同，运行时检查后消费。"
          },
          "verificationInheritedFrom": {
            "type": "object",
            "required": [
              "bindingId",
              "artifactId",
              "verificationHash",
              "inheritedAt"
            ],
            "properties": {
              "bindingId": {
                "type": "string"
              },
              "artifactId": {
                "type": "string"
              },
              "verificationHash": {
                "type": "string"
              },
              "inheritedAt": {
                "type": "string"
              }
            },
            "description": "运行时记录的继承来源，不表示本次重新执行浏览器验证。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verified": {
                  "const": true
                }
              },
              "required": [
                "verified"
              ]
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "supersessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "operation": {
            "enum": [
              "split",
              "merge",
              "remove"
            ]
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "uniqueItems": true
          },
          "createdAt": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
